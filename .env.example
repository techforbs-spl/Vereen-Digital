# ==========================================
# Vereen Digital — Environment Configuration Example
# Copy this file to .env.local and update the values
# ==========================================

# 1. Calendly Event Link (e.g. https://calendly.com/vereendigitall/30min)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/vereendigitall/30min

# 2. Contact / Notification Email (Inquiry forms will be sent TO this email)
NEXT_PUBLIC_CONTACT_EMAIL=brandon@vereendigital.com
CONTACT_RECEIVER_EMAIL=brandon@vereendigital.com

# 3. Company Name
NEXT_PUBLIC_COMPANY_NAME=Vereen Digital

# ==========================================
# 4. EMAIL SENDING SERVICE (SMTP or RESEND)
# ==========================================
# Option A: SMTP (Hostinger / Gmail / Custom Domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=brandon@vereendigital.com
SMTP_PASS=your-smtp-password
SMTP_FROM=brandon@vereendigital.com

# Option B: Resend API (Alternative for Vercel)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Vereen Digital <onboarding@resend.dev>
